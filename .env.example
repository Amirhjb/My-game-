# Copia este fichero como `.env.local` y pega tu clave.
# `.env.local` NO se sube al repositorio (está en .gitignore), pero SÍ se compila
# dentro de jugar.html, así que la partida arranca sin escribir nada en Ajustes.
#
#   cp .env.example .env.local
#   # pega la clave en la línea de abajo
#   npm run dist
#
# Claves gratuitas:
#   Groq   → https://console.groq.com/keys
#   Gemini → https://aistudio.google.com/apikey

VITE_API_KEY=

# --- Groq (por defecto) ---
VITE_API_PROVIDER=groq
VITE_API_BASE_URL=https://api.groq.com/openai/v1
VITE_API_MODEL=llama-3.3-70b-versatile

# --- Google Gemini: descomenta estas tres y comenta las de arriba ---
# VITE_API_PROVIDER=gemini
# VITE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VITE_API_MODEL=gemini-2.5-flash
