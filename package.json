{
  "name": "ultimo-relato",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Aventura narrativa por IA: supervivencia, gestión y exploración procedural.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "dist": "npm run build:single && cp dist-single/index.html jugar.html"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
